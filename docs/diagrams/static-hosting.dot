digraph G {
  graph [bgcolor="white", rankdir=LR, pad="0.22", nodesep="0.42", ranksep="0.7", fontname="Lato", fontsize=12, labelloc=t, label="Static hosting · private origin and SPA routing"];
  node [shape=box, style="rounded,filled", fontname="Lato", fontsize=11, color="#3b5b7a", penwidth=1.2, margin="0.16,0.11"];
  edge [fontname="Lato", fontsize=9, color="#3b5b7a", fontcolor="#3b5b7a", arrowsize=0.7, penwidth=1.1];

  browser [label="Browser", fillcolor="#ffffff"];
  build [label="Vite build\ndist/", fillcolor="#ffffff"];

  subgraph cluster_stack {
    label="StaticHostingStack · eu-north-1"; color="#ff9900"; penwidth=1.4; style="rounded"; fontcolor="#5c4100";
    deploy [label="CDK BucketDeployment\nupload + invalidate /*", fillcolor="#eef3f8"];
    bucket [label="Private S3 bucket\nversioned · encrypted\nblock all public access", fillcolor="#d9ead3"];
    cf [label="CloudFront distribution\nHTTPS redirect · optimized cache\nOrigin Access Control", fillcolor="#ffebcc"];
    spa [label="SPA fallback\n403 / 404 → /index.html\nresponse 200 · cache 0 s", fillcolor="#ffffff"];
  }

  build -> deploy;
  deploy -> bucket [label="publish assets"];
  deploy -> cf [label="invalidate cache", style=dashed];
  browser -> cf [label="HTTPS"];
  cf -> bucket [label="signed origin request"];
  spa -> cf [label="error response policy", style=dashed];
}
